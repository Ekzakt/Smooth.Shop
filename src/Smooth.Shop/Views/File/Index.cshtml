@{
    ViewData["Title"] = "File Upload";
}
<h2>@ViewData["Title"]</h2>

<form id="fileUploadForm">
    @Html.AntiForgeryToken()
    <input type="file" id="fileInput" multiple />
    <div id="progressContainer"></div>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        const sasService = new SasTokenService("/file/sas");
        const fileUploader = new FileUploader(sasService);
        const signalRService = new SignalRService("/uploadHub");

        signalRService.startConnection();

        document.getElementById("fileInput").addEventListener("change", function () {
            const files = this.files;
            if (!files || files.length === 0) return;

            const progressContainer = document.getElementById("progressContainer");
            progressContainer.innerHTML = "";

            Array.from(files).forEach((file) => {
                const progressBar = new ProgressBar(file, progressContainer)

                fileUploader.uploadFile(
                    file,
                    signalRService.getConnectionId(),
                    progressBar,
                    (response) => {
                        console.log(`Upload complete for ${file.name}:`, response);
                    },
                    (error) => {
                        console.error(`Error uploading ${file.name}:`, error);
                    }
                );
            });
        });
    });
</script>
