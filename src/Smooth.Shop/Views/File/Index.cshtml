@{
    ViewData["Title"] = "File Upload";
}
<h2>@ViewData["Title"]</h2>

<script>
    class SasTokenService {
        constructor(endpoint) {
            this.endpoint = endpoint; // API endpoint to fetch the SAS token
        }

        getSasToken(callback) {
            const xhr = new XMLHttpRequest();
            xhr.open("GET", this.endpoint, true); // Make a GET request to the endpoint

            xhr.onreadystatechange = function () {
                if (xhr.readyState === 4) { // Check if the request is complete
                    if (xhr.status === 200) { // Check if the response status is OK
                        try {
                            const response = JSON.parse(xhr.responseText); // Parse the JSON response
                            if (callback && typeof callback === "function") {
                                callback(null, response.sasToken); // Pass the SAS token to the callback
                            }
                        } catch (error) {
                            console.error("Error parsing response:", error);
                            if (callback) callback(error, null);
                        }
                    } else {
                        console.error(`Failed to get SAS token. Status: ${xhr.status}, Message: ${xhr.statusText}`);
                        if (callback) callback(new Error(xhr.statusText), null);
                    }
                }
            };

            xhr.onerror = function () {
                console.error("An error occurred during the request.");
                if (callback) callback(new Error("Network error"), null);
            };

            xhr.send(); // Send the request
        }
    }

    // Example usage:
    const sasService = new SasTokenService("/file/sas");

    // Fetch the SAS token and handle it via a callback
    sasService.getSasToken((error, sasToken) => {
        if (error) {
            console.error("Error fetching SAS token:", error.message);
        } else {
            console.log("SAS Token:", sasToken);
            // You can now use the SAS token
        }
    });
</script>